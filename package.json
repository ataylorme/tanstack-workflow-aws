{
  "name": "@ataylorme/tanstack-workflow-aws",
  "version": "0.1.0",
  "type": "module",
  "description": "Experimental AWS DynamoDB execution store for TanStack Workflow",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "cloudformation",
    "examples",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "test:package": "node scripts/delivery-package.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@standard-schema/spec": "^1.1.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ataylorme/tanstack-workflow-aws.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
