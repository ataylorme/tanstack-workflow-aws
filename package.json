{
  "name": "@ataylorme/tanstack-workflow-aws",
  "version": "0.2.0-rc.0",
  "type": "module",
  "description": "Experimental AWS DynamoDB execution store for TanStack Workflow",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./event-stream": {
      "types": "./dist/event-stream.d.ts",
      "import": "./dist/event-stream.js"
    },
    "./bridges/eventbridge": {
      "types": "./dist/bridges-eventbridge.d.ts",
      "import": "./dist/bridges-eventbridge.js"
    },
    "./bridges/sns": {
      "types": "./dist/bridges-sns.d.ts",
      "import": "./dist/bridges-sns.js"
    },
    "./bridges/sqs": {
      "types": "./dist/bridges-sqs.d.ts",
      "import": "./dist/bridges-sqs.js"
    },
    "./bridges/webhook": {
      "types": "./dist/bridges-webhook.d.ts",
      "import": "./dist/bridges-webhook.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "cloudformation",
    "examples",
    "src",
    "scripts/test-events-live.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "test:package": "node scripts/delivery-package.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:events:live": "npm run build && node scripts/test-events-live.mjs",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@opentelemetry/api": "^1.9.0",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-eventbridge": "^3.1141.0",
    "@aws-sdk/client-scheduler": "3.1136.0",
    "@aws-sdk/client-sns": "^3.1141.0",
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ataylorme/tanstack-workflow-aws.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@aws-sdk/client-eventbridge": "^3.1141.0",
    "@aws-sdk/client-sns": "^3.1141.0",
    "@aws-sdk/client-sqs": "^3.1141.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-eventbridge": {
      "optional": true
    },
    "@aws-sdk/client-sns": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    }
  }
}
